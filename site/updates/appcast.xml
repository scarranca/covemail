            <sparkle:version>63</sparkle:version>
            <sparkle:shortVersionString>0.1.61</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Cove 0.1.61</title></head><body><h1>Your next meeting, in the menu bar</h1><ul><li>Turn on Meetings in the menu bar (Settings → Gmail) to see your next meeting at a glance: “Standup in 8m”, then “Join Standup”.</li><li>When a call with other people is about to start, the icon pulses. Join is one click away, for Google Meet, Zoom, Teams and Webex links.</li><li>The panel also lists your later meetings today and opens any of them in Cove.</li></ul><p>It’s off by default, and it stays still with Reduce Motion.</p></body></html>
]]></description>
            <enclosure url="https://covemail.xyz/downloads/Cove-0.1.61.dmg" length="22969948" type="application/octet-stream" sparkle:edSignature="oO8gG0JZ1aoHyspHbQDy5kB20OxcUvVtaRaKR1S7ex1XKLCZxm4cDRhDuVjMDdnmhTnYJG1W6YkO7ASzHAflDg=="/>
