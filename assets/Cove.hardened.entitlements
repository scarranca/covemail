<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when .local/Cove.provisionprofile exists. Without a matching provisioning
     profile these restricted entitlements stop the app at launch, so they are never the default. -->
<plist version="1.0"><dict>
  <key>com.apple.security.personal-information.location</key><true/>
  <key>com.apple.application-identifier</key><string>27H459Y2P9.ai.cove.mac</string>
  <key>com.apple.developer.team-identifier</key><string>27H459Y2P9</string>
  <key>keychain-access-groups</key><array><string>27H459Y2P9.ai.cove.mac</string></array>
</dict></plist>
